# =============================================================================
# Sistem Multimedia GPI — contoh konfigurasi. Salin menjadi .env lalu isi.
# Nilai di bawah ini sudah disetel untuk SERVER ONLINE (produksi).
# Untuk komputer lokal (XAMPP): APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost
# =============================================================================

APP_NAME="Sistem Multimedia GPI"
APP_ENV=production
# Buat dengan: php artisan key:generate
APP_KEY=
# WAJIB false di server online (true membocorkan isi kode & kata sandi saat error)
APP_DEBUG=false
# Alamat lengkap web, pakai https (semua tautan otomatis ikut https)
APP_URL=https://multimedia.contoh-gereja.org

# Isi "*" bila web berada di balik Cloudflare / load balancer / proxy panel hosting
# (agar HTTPS & IP pengunjung terbaca benar). Kosongkan bila tidak.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_multimedia_gpi
DB_USERNAME=
DB_PASSWORD=

# Akun admin pertama (dipakai sekali oleh: php artisan db:seed --force).
# Kosongkan ADMIN_PASSWORD agar dibuatkan kata sandi acak yang ditampilkan di terminal.
ADMIN_NAME="Admin Multimedia"
ADMIN_EMAIL=admin@gpipapua.org
ADMIN_PASSWORD=

BROADCAST_DRIVER=log
# file = cukup untuk 1 server. Cache juga menyimpan pasal Alkitab & status layar live.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Menit sebelum otomatis keluar bila tidak aktif (480 = 8 jam, cukup untuk 1 hari ibadah)
SESSION_LIFETIME=480
# true bila memakai https (cookie login hanya dikirim lewat koneksi aman)
SESSION_SECURE_COOKIE=true

# Logo layar live dari URL lain (opsional; lebih mudah unggah lewat menu Pengaturan)
PRESENTATION_LOGO_URL=

# Email untuk fitur "Lupa kata sandi". Tanpa SMTP, admin tetap bisa mengatur ulang
# kata sandi siapa pun dari menu Pengguna.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@contoh-gereja.org"
MAIL_FROM_NAME="${APP_NAME}"

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
